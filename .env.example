# Used locally by `npm run build:index` and as the chat runtime fallback.
OPENAI_API_KEY=

# Optional. When set, the chat prefers Vercel AI Gateway over OPENAI_API_KEY.
AI_GATEWAY_API_KEY=

# Optional. Production uses this deployment's /api/mcp.
# Local chat uses https://ai-nikechan-mcp.vercel.app/api/mcp by default.
MCP_SERVER_URL=

# Optional override. Both gpt-5.6-luna and openai/gpt-5.6-luna are accepted.
AI_CHAT_MODEL=gpt-5.6-luna

# Required only when `npm run upload:index` uploads the private index to Vercel Blob.
BLOB_READ_WRITE_TOKEN=
