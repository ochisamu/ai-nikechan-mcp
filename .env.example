# Used locally by `npm run build:index` and as the chat runtime fallback.
OPENAI_API_KEY=

# Optional. When set, the chat prefers Vercel AI Gateway over OPENAI_API_KEY.
AI_GATEWAY_API_KEY=

# Optional. Source MCP used only when regenerating the cached setup-page tool trials.
MCP_SERVER_URL=

# Optional override. Both gpt-5.4-nano and openai/gpt-5.4-nano are accepted.
AI_CHAT_MODEL=gpt-5.4-nano

# Required only when `npm run upload:index` uploads the private index to Vercel Blob.
BLOB_READ_WRITE_TOKEN=
