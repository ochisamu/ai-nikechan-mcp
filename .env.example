# Preferred for chat and embeddings. Direct chat uses gpt-5.6-luna by default.
OPENAI_API_KEY=

# Optional fallback when the direct OpenAI request is unavailable.
AI_GATEWAY_API_KEY=

# Optional. Source MCP used only when regenerating the cached setup-page tool trials.
MCP_SERVER_URL=

# Optional direct OpenAI chat model override.
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Optional Gateway fallback model override. Keep the creator prefix for non-OpenAI models.
AI_CHAT_MODEL=zai/glm-5.3-flash

# Required only when `npm run upload:index` uploads the private index to Vercel Blob.
BLOB_READ_WRITE_TOKEN=
